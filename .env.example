# Copy to .env for local development, or set the same keys in the Netlify UI
# (Site configuration → Environment variables), Railway, or Vercel project variables.
# VITE_* values are baked in at build time and must be present when `npm run build` runs.
# The Dockerfile sets DEMO_MODE and VITE_DEMO_MODE. Login stays IP-restricted
# on Railway the same way it does on Netlify. Add addresses at
# /adminuseradmin_useradminuser. Do not set LOGIN_OPEN.

# --- Required for a useful hosted demo ---
DEMO_MODE=true
VITE_DEMO_MODE=true
JWT_SECRET=change-me-to-a-long-random-string

# Login IP allowlist (comma or newline separated). Required on Netlify unless
# you add IPs at /adminuseradmin_useradminuser. Loopback is allowed by default
# for local development only.
# ALLOWED_LOGIN_IPS=203.0.113.10,198.51.100.22

# --- PostgreSQL records (Neon on Vercel, or another PostgreSQL provider) ---
# Use the pooled URL supplied by the integration, including its TLS options.
# Once DATABASE_URL is present, app data, settings and login history use SQL.
# DATABASE_URL=postgresql://...
# Netlify Database supplies NETLIFY_DB_URL automatically; DATABASE_URL overrides it.
# DATA_STORAGE_PROVIDER=postgres
# DATA_NAMESPACE=production
# SQL tables are initialized automatically. Images and documents still use the
# file storage configured below (or Netlify Blobs when deploying on Netlify).

# --- Vercel private Blob storage (server-only) ---
# Connect a PRIVATE Blob store to the Vercel project. The SDK uses the connected
# store's BLOB_STORE_ID + VERCEL_OIDC_TOKEN, or BLOB_READ_WRITE_TOKEN.
# STORAGE_PROVIDER=vercel
# BLOB_READ_WRITE_TOKEN=   # Set in hosting settings; never prefix with VITE_.
# BLOB_STORE_ID=          # For connected stores using Vercel OIDC.
# Optional namespace. Default: realtychain/<VERCEL_ENV>, or realtychain/development.
# Use a different prefix/store for development, preview and production data.
# BLOB_PREFIX=realtychain/production

# --- Solana (leave the program id unset to browse without sending transactions) ---
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# VITE_SOLANA_PROGRAM_ID=
# Circle devnet USDC. The configure instruction stores this mint on the protocol config account.
# VITE_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional MoonPay handoff on Get USDC
# VITE_MOONPAY_PUBLISHABLE_KEY=
# VITE_MOONPAY_SANDBOX=true

# Sumsub sandbox KYC. Create the app token while the dashboard is in Sandbox
# mode (cockpit.sumsub.com). Server-only — do not prefix these with VITE_.
# Webhook URL: https://<site>/api/kyc/sumsub/webhook (applicantReviewed, HMAC SHA-256).
# On Vercel, set NODEJS_HELPERS=0 so Express retains raw webhook bytes.
# NODEJS_HELPERS=0
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_LEVEL_NAME=basic-kyc-level

# Recurring ledger purchase runner (server-only; never prefix with VITE_).
# Set the same random value, at least 32 characters, in the deployed API and scheduled function.
# INVESTMENT_SCHEDULER_SECRET=
