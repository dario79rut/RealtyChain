    "@sumsub/websdk": "^2.9.0",
    "@tanstack/react-query": "^5.81.2",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^11.5.4",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.441.0",
    "patch-package": "^8.0.1",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "serverless-http": "^3.2.0",
