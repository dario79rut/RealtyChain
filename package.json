{
  "name": "web",
  "private": true,
  "scripts": {
    "start": "node scripts/start-local.js",
    "dev": "concurrently \"node server/app.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/app.js",
    "lint": "eslint .",
    "test": "npm run test:server && npm run test:contracts",
    "test:server": "node --test server/tests/*.test.js",
